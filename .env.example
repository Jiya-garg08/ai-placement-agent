# ==============================================================================
# AI Placement Preparation Agent - Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Local Development & Offline Mock Mode (Set to True to avoid Azure spending)
AZURE_MOCK_MODE=True

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/placement.db

# Microsoft Foundry / Azure OpenAI Configuration (Used in Phase 6 & Phase 8)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Microsoft Foundry Agent Service (Optional project connection string)
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com/api/projects/<project-id>

# Azure AI Search (Used in Phase 6 for RAG Vector + Hybrid Search)
AZURE_SEARCH_SERVICE_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX_NAME=placement-kb-index

# GitHub Tool Integration (Optional for demonstration)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Budget Guard Settings (Alert threshold in USD)
AZURE_DAILY_BUDGET_LIMIT=3.00
AZURE_TOTAL_BUDGET_CAP=200.00
